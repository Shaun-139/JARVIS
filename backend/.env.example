# Copy this file to .env.local and fill in your key. .env.local is git-ignored.
# Without GROQ_API_KEY the proxy still runs in "mock" mode (canned replies).

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# --- Chat -------------------------------------------------------------------
# Models on Groq right now: openai/gpt-oss-20b (fast), openai/gpt-oss-120b
# (higher quality), groq/compound, qwen/qwen3.8-27b. See console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-20b

# Extra chat providers — the model dropdown switches between whichever are set.
# Each is reached over its OpenAI-compatible streaming endpoint.
# OPENROUTER_API_KEY=              # openrouter.ai/keys
# OPENROUTER_MODEL=openrouter/auto
# GEMINI_API_KEY=                  # aistudio.google.com/apikey
# GEMINI_MODEL=gemini-flash-latest
# OLLAMA_URL=http://localhost:11434   # run `ollama serve`; no key needed
# OLLAMA_MODEL=llama3.2

# Which provider a request uses when the client doesn't say (default: groq).
# DEFAULT_PROVIDER=groq

# --- Speech-to-text -------------------------------------------------------- #
# Works out of the box on a standard Groq key.
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Text-to-speech ----------------------------------------------------------
# Groq's Orpheus voice needs one-time terms acceptance here:
#   https://console.groq.com/playground?model=canopylabs/orpheus-v1-english
# Until you accept + set GROQ_TTS_ENABLED=1, TalkAI speaks with the browser's
# built-in SpeechSynthesis (no key, no cost).
GROQ_TTS_ENABLED=0
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara

API_PORT=8787

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list of frontend origin(s) once deployed separately
# (e.g. https://your-app.vercel.app). Unset = reflect any origin (fine — no
# cookies are used here — but only meant for a quick smoke test).
# CORS_ORIGIN=

# --- Personal-machine telemetry ----------------------------------------------
# Optional. Lets `npm run agent` (backend/agent.mjs, run on your own machine)
# feed YOUR real CPU/RAM into the deployed HUD instead of it only ever
# showing whatever container this proxy happens to be hosted on.
#
# Set AGENT_TOKEN here (any random string) AND as an env var on the deployed
# server — same value both places. Then set AGENT_TARGET_URL to that server's
# URL and run `npm run agent` locally. Leave both unset to skip this entirely;
# the HUD just shows this proxy's own host stats, which is the default.
# AGENT_TOKEN=
# AGENT_TARGET_URL=https://your-backend.onrender.com

# --- Whole-app access gate ---------------------------------------------------
# Optional. Set to require a password before the frontend does anything at
# all — chat, voice, telemetry, everything — protecting both your API usage
# and your personal telemetry from anyone who finds the URL. Unset = fully
# open (today's default). The browser prompts once per device and remembers
# it there; set the SAME value here and on the deployed server.
# APP_PASSWORD=
